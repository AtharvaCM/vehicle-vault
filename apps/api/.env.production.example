NODE_ENV=production
PORT=3001

# Where this API answers from on the public internet, including the /api prefix.
# Used to build the unsubscribe link and List-Unsubscribe header on alert email.
# Alert email is withheld entirely when this is unset — an alert with a dead
# opt-out link is worse than no alert. Transactional mail is unaffected.
API_PUBLIC_URL=https://vehiclevault.example.com/api

# Rate limiting on the public auth endpoints, per client IP. On unless NODE_ENV
# is test. Each limit is `requests/windowSeconds`; a value that does not parse
# keeps its default, and the limits in force are logged at startup.
#   login, register            credential stuffing, account farming
#   mail                       forgot-password, resend-verification (sends email)
#   token                      reset-password confirm, refresh, invite accept
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=5/60
RATE_LIMIT_REGISTER=5/60
RATE_LIMIT_MAIL=3/900
RATE_LIMIT_TOKEN=20/60
# Whether the client IP may come from X-Forwarded-For. Leave unset (off) unless a
# reverse proxy you control sits in front of the API: without one, trusting the
# header lets any client choose the IP it is rate-limited under. Behind a proxy,
# off means every client shares the proxy's IP and one limit. Accepts true, a
# hop count, or addresses/subnets — passed to Express's `trust proxy`.
# Behind Cloudflare → cloudflared (→ nginx-proxy-manager) → Docker, trust the
# private hops only. Express walks X-Forwarded-For from the right, skips those,
# and stops at the first public address — the one Cloudflare saw. Do not use
# `true`: it takes the leftmost entry, and Cloudflare appends the real client IP
# after anything the client sent, so a caller could pick its own rate-limit key.
TRUST_PROXY=loopback, linklocal, uniquelocal

# Comma-separated emails granted the admin role. Reconciled on every boot:
# listed users are promoted to admin, admins no longer listed are demoted.
# This env var is the only way to mint an admin — there is no self-serve path.
ADMIN_EMAILS=

# Set this to the browser frontend origin. You can provide a comma-separated
# allowlist during a domain transition.
FRONTEND_ORIGIN=https://vehicle-vault-eight.vercel.app

# Optional regex for preview deployments, for example:
# ^https://vehicle-vault.*\.vercel\.app$
FRONTEND_ORIGIN_PATTERN=

# Supabase Postgres transaction-mode pooler (port 6543) for runtime queries.
# pgbouncer=true disables prepared statements; connection_limit=1 keeps each
# Prisma instance from saturating the shared pool.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1

# Session-mode pooler (port 5432) for Prisma migrate / introspection — needs prepared statements.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-1-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=vehicle-vault-attachments

# AI Integration
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-this-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Either provide a full SMTP connection URL or set the host/port/user/pass fields below.
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Vehicle Vault <no-reply@middle-earth.in>
MAIL_REPLY_TO=support@middle-earth.in
