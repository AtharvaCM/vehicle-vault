PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_ORIGIN_PATTERN=
# Where this API answers from on the public internet, including the /api prefix.
# Used to build the unsubscribe link and List-Unsubscribe header on alert email.
# Alert email is withheld entirely when this is unset — an alert with a dead
# opt-out link is worse than no alert. Transactional mail is unaffected.
API_PUBLIC_URL=http://localhost:3001/api

# Rate limiting on the public endpoints, per client IP. On unless NODE_ENV
# is test. Each limit is `requests/windowSeconds`; a value that does not parse
# keeps its default, and the limits in force are logged at startup.
#   login, register            credential stuffing, account farming
#   mail                       forgot-password, resend-verification (sends email)
#   token                      reset-password confirm, refresh, invite accept
#   catalog                    public catalog page reads (loose; caps scrapers)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=5/60
RATE_LIMIT_REGISTER=5/60
RATE_LIMIT_MAIL=3/900
RATE_LIMIT_TOKEN=20/60
RATE_LIMIT_CATALOG=120/60
# Whether the client IP may come from X-Forwarded-For. Leave unset (off) unless a
# reverse proxy you control sits in front of the API: without one, trusting the
# header lets any client choose the IP it is rate-limited under. Behind a proxy,
# off means every client shares the proxy's IP and one limit. Accepts true, a
# hop count, or addresses/subnets — passed to Express's `trust proxy`.
TRUST_PROXY=
NODE_ENV=development
# Comma-separated emails granted the admin role. Reconciled on every boot:
# listed users are promoted, admins no longer listed are demoted. Source of truth.
ADMIN_EMAILS=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vehicle_vault?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/vehicle_vault?schema=public
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=vehicle-vault-attachments
JWT_SECRET=vehicle-vault-dev-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=vehicle-vault-dev-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# AI Integration
GEMINI_API_KEY=your-gemini-api-key-from-ai-studio
GEMINI_MODEL=gemini-2.5-flash

# OAuth (Google + GitHub). Leave unset to disable a provider; the login
# page will hide the corresponding button automatically.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/oauth/google/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/oauth/github/callback
# Where the API redirects after the provider hands the user back. Defaults to
# {FRONTEND_ORIGIN}/auth/oauth-callback when unset.
OAUTH_FRONTEND_REDIRECT_URL=

# Web push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@vehiclevault.middle-earth.in

# Error reporting (optional — unset means no client is created and nothing is sent).
# GlitchTip speaks the Sentry protocol: paste the DSN from your GlitchTip project.
SENTRY_DSN=
