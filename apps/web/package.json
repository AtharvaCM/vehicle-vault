{
  "name": "@vehicle-vault/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @vehicle-vault/shared build",
    "dev": "vite",
    "prebuild": "pnpm --filter @vehicle-vault/shared build",
    "build": "tsc --noEmit && vite build",
    "build:prerendered": "pnpm run build && pnpm run build:ssr && pnpm run prerender",
    "build:ssr": "NODE_ENV=production vite build --ssr src/prerender/cli.ts --outDir dist-ssr --emptyOutDir",
    "prerender": "NODE_ENV=production node dist-ssr/cli.js",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "format": "prettier --check .",
    "clean": "rimraf dist dist-ssr"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/react": "^10.70.0",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-query-devtools": "^5.103.2",
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@vehicle-vault/shared": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.47.0",
    "papaparse": "^5.5.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "workbox-window": "^7.4.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vehicle-vault/config": "workspace:*",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "shadcn": "^4.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  }
}
