# Local development API URL
VITE_API_BASE_URL=http://localhost:3001/api

# Error reporting (optional — unset means no client is created and nothing is sent).
# GlitchTip speaks the Sentry protocol: paste the DSN from your GlitchTip project.
VITE_SENTRY_DSN=

# Microsoft Clarity (optional — unset means the script is never injected and no
# request goes to clarity.ms). Everything inside the signed-in app is masked in
# recordings via `data-clarity-mask`; also set the project's masking mode to
# Strict in the Clarity dashboard. Public pages (landing, sign-in) stay visible.
VITE_CLARITY_PROJECT_ID=

# Origin for canonical and Open Graph URLs on public catalog pages (optional;
# defaults to the production custom domain, never the vercel.app alias).
VITE_CANONICAL_ORIGIN=

# Build-time only: `pnpm --filter @vehicle-vault/web build:prerendered` writes a
# static page per catalog variant when this is set, and fails the build if the
# API is unreachable or the catalog empty. Unset, the prerender is skipped.
# PRERENDER_API_BASE_URL=http://localhost:3001/api

# Build-time: whether public catalog pages may be indexed by search engines.
# Off unless `on`. Off, every catalog page is `noindex` and the prerender writes
# no sitemap.xml; on, the API's page-quality gate decides page by page and the
# sitemap lists the pages it passes. Leave it off until the catalog data's
# provenance is signed off (PRD #169). Set it for the whole build:prerendered.
# VITE_PUBLIC_CATALOG_INDEXING=on
